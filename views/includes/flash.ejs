<!-- // shows alerts when creating a new list -->
<% if(success && success.length > 0) { %> 
<div class="alert alert-success mt-3 alert-dismissible fade show col-6 offset-3" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<!-- shows a clean err msg instead of complex msg which user cant understand -->
<% if(error && error.length > 0) { %> 
<div class="alert alert-danger mt-3 alert-dismissible fade show col-6 offset-3" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

